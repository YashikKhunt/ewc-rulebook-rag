# Copy to .env and fill in. .env is gitignored — never put a real key in this file.
#
#   cp .env.example .env
#
# Everything except OPENAI_API_KEY is optional; the value shown is the default the
# code falls back to when the variable is unset.

# --- Required ------------------------------------------------------------------
# Used for both embeddings and generation.
OPENAI_API_KEY=sk-...

# --- Models --------------------------------------------------------------------
# Changing the embedding model invalidates the Chroma collection: re-run index.py.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Crawl (ingest.py, articles.py) --------------------------------------------
# Root of the official competitive-ops resource. Detail pages and the CDN PDF URLs
# are discovered from here at runtime — no URL or game slug is ever hardcoded.
EWC_BASE_URL=https://resources.esportsworldcup.com/en/competitive-ops

# Scraping etiquette: identify yourself, stay serial, stay slow. Do not raise the
# rate or parallelise — this is a public official resource. Put a real contact here.
EWC_USER_AGENT=ewc-rulebook-rag/0.1 (+contact: you@example.com)
EWC_CRAWL_DELAY=0.6

# --- Paths ---------------------------------------------------------------------
# All of these live under data/, which is gitignored.
EWC_DATA_DIR=data
EWC_CHROMA_DIR=data/chroma
EWC_CHROMA_COLLECTION=ewc_rulebooks

# --- Front-end / server (S6) ---------------------------------------------------
# The server binds loopback only and must not be exposed beyond localhost: it
# serves locally-cached PDFs that are the Esports Foundation's content.
EWC_SERVER_HOST=127.0.0.1
EWC_SERVER_PORT=8000

# Server-side spend ceilings. Both refuse BEFORE any model call.
EWC_BUDGET_DAILY_USD=0.50
EWC_BUDGET_CONVERSATION_USD=0.10
